# AnalyticX environment variables
# Copy to .env.local and fill in real values. Never commit secrets.

# Public Supabase (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only Supabase (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# TwitterAPI.io (server-only)
TWITTERAPI_IO_KEY=PASTE_YOUR_TWITTERAPI_IO_API_KEY_HERE

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron / scheduled jobs (Vercel Cron Authorization header)
CRON_SECRET=generate-a-long-random-secret

# Optional: enable mock TwitterAPI responses when no key is set
# TWITTERAPI_IO_MOCK=true
